```{=html}
<% if (items.length === 0) { %>
  <div class="aventuras-vacio">
    <i class="bi bi-compass"></i>
    <p>Todavía no hay aventuras publicadas.<br>Las primeras rutas están en camino.</p>
  </div>
<% } %>
<div class="list aventuras-lista">
<% for (const item of items) { %>
  <article class="aventura<%= item.secreto ? ' aventura-secreta' : '' %>" <%= metadataAttrs(item) %>>
    <a class="aventura-enlace" href="<%- item.path %>">
      <% if (!item.secreto && item.image) { %>
        <img class="aventura-portada" src="<%- item.image %>" alt="" loading="lazy">
      <% } %>
      <div class="aventura-cuerpo">
        <div class="aventura-meta">
          <span class="listing-date"><%= item.date %></span>
          <% if (item.lugar) { %> · <i class="bi bi-geo-alt"></i> <%= item.lugar %><% } %>
        </div>
        <h3 class="aventura-titulo listing-title"><%= item.title %></h3>
        <% if (item.description) { %><p class="aventura-resumen listing-description"><%= item.description %></p><% } %>
      </div>
      <% if (item.secreto) { %>
        <i class="aventura-candado bi bi-lock-fill" role="img" aria-label="Acertijo sin resolver"></i>
      <% } %>
    </a>
  </article>
<% } %>
</div>

<script>
  // Aventuras secretas: candado abierto si este navegador ya resolvió el acertijo
  // (recursos/js/acertijo.js guarda la respuesta con la clave "acertijo:<ruta de la aventura>")
  document.querySelectorAll(".aventura-secreta").forEach(function (tarjeta) {
    var ruta = new URL(tarjeta.querySelector("a").href).pathname.replace(/index\.html$/, "");
    var resuelta = false;
    try { resuelta = !!localStorage.getItem("acertijo:" + ruta); } catch (e) {}
    if (!resuelta) return;
    var candado = tarjeta.querySelector(".aventura-candado");
    candado.classList.replace("bi-lock-fill", "bi-unlock-fill");
    candado.setAttribute("aria-label", "Acertijo resuelto");
    tarjeta.classList.add("resuelta");
  });
</script>
```
