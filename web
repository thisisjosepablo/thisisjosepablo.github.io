# ---------------------------------------------------------------- acertijos

ITERACIONES = 600_000      # PBKDF2: cuanto más alto, más lento probar respuestas a ciegas


def normalizar(texto):
    """"Mulhacén " → "mulhacen" (igual que normalizar() en recursos/js/acertijo.js)."""
    t = unicodedata.normalize("NFKD", texto).encode("ascii", "ignore").decode().lower()
    return "".join(c for c in t if c.isalnum())


def b64(datos):
    return base64.b64encode(datos).decode()


def cifrar(secreto, respuestas):
    """Cifra el secreto una vez por cada respuesta válida (todas comparten la sal).
    Mismo esquema que descifrar() en recursos/js/acertijo.js."""
    sal = secrets.token_bytes(16)
    claro = json.dumps(secreto, ensure_ascii=False).encode()
    cajas = []
    for r in respuestas:
        k = hashlib.pbkdf2_hmac("sha256", r.encode(), sal, ITERACIONES, dklen=64)
        flujo = b"".join(hmac.new(k[:32], i.to_bytes(4, "big"), "sha256").digest()
                         for i in range((len(claro) + 31) // 32))
        cifra = bytes(x ^ y for x, y in zip(claro, flujo))
        cajas.append({"cifra": b64(cifra), "sello": b64(hmac.new(k[32:], cifra, "sha256").digest())})
    secrets.SystemRandom().shuffle(cajas)
    return {"version": 1, "iteraciones": ITERACIONES, "sal": b64(sal), "cajas": cajas}


def id_youtube(enlace):
    m = (re.search(r"(?:youtu\.be/|[?&]v=|/embed/|/shorts/|/live/)([\w-]{11})", enlace)
         or re.fullmatch(r"([\w-]{11})", enlace))
    if not m:
        sys.exit(f"No reconozco el enlace de YouTube: {enlace}")
    return m.group(1)


def acertijo(a):
    carpeta = Path(a.carpeta).resolve()
    qmd = carpeta / "index.qmd"
    if not qmd.exists():
        sys.exit(f"No encuentro {qmd}")
    texto = qmd.read_text()
    ini, fin = "<!-- acertijo:inicio -->", "<!-- acertijo:fin -->"
    if ini not in texto or fin not in texto:
        sys.exit(f"Faltan las marcas {ini} / {fin} en el index.qmd (créala con ./web aventura --secreta).")

    secreto = {}
    enlace = a.video if a.video is not None else input("Enlace del vídeo de YouTube (Enter si no hay): ")
    if enlace.strip():
        secreto["video"] = id_youtube(enlace.strip())
    cronica = carpeta / "_secreto.md"
    if cronica.exists():
        secreto["html"] = subprocess.run(["quarto", "pandoc", str(cronica), "-t", "html", "--wrap=none"],
                                         capture_output=True, text=True, check=True).stdout
    if not secreto:
        sys.exit("No hay nada que esconder: pasa --video o escribe _secreto.md.")

    respuestas = a.respuesta or []
    if not respuestas:
        print("Respuestas válidas del acertijo (da igual tildes, mayúsculas y espacios).")
        while r := input("Respuesta" + (" (Enter para terminar)" if respuestas else "") + ": "):
            respuestas.append(r)
    respuestas = list(dict.fromkeys(filter(None, map(normalizar, respuestas))))
    if not respuestas:
        sys.exit("Hace falta al menos una respuesta.")
    for r in respuestas:
        if len(r) < 6:
            print(f"  Aviso: «{r}» es corta; cuanto más corta, más fácil de adivinar probando.")

    datos = cifrar(secreto, respuestas)
    bloque = ("```{=html}\n"
              f'<script type="application/json" id="acertijo-datos">{json.dumps(datos)}</script>\n'
              '<script type="module" src="/recursos/js/acertijo.js"></script>\n'
              "```")
    antes, resto = texto.split(ini, 1)
    qmd.write_text(antes + ini + "\n" + bloque + "\n" + fin + resto.split(fin, 1)[1])
    partes = (["vídeo"] if "video" in secreto else []) + (["crónica de _secreto.md"] if "html" in secreto else [])
    print(f"✔ Cifrado ({' y '.join(partes)}) con {len(respuestas)} respuesta(s) válida(s): {', '.join(respuestas)}")
    print("  La respuesta no se guarda en ningún sitio: apúntala si no quieres olvidarla.")


