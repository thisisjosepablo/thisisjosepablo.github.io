# ---------------------------------------------------------------- utilidades

def slug(texto):
    """"Mi primera nota!" → "mi-primera-nota" (sin tildes ni símbolos)."""
    t = unicodedata.normalize("NFKD", texto).encode("ascii", "ignore").decode().lower()
    return "-".join("".join(c if c.isalnum() else " " for c in t).split()) or "sin-titulo"


def comillas(texto):
    return '"' + texto.replace("\\", "\\\\").replace('"', '\\"') + '"'


def carpeta_fechada(seccion, titulo):
    """<sección>/<año>/<mes>-<nombre>/ ; falla si ya existe."""
    carpeta = RAIZ / seccion / f"{HOY:%Y}" / f"{HOY:%m}-{slug(titulo)}"
    if carpeta.exists():
        sys.exit(f"Ya existe {carpeta.relative_to(RAIZ)}/")
    return carpeta


def abrir(ruta):
    """Abre el archivo en VS Code (o en $EDITOR) si está disponible."""
    editor = "code" if shutil.which("code") else os.environ.get("EDITOR")
    if editor:
        subprocess.run([editor, str(ruta)])


def preview_activa():
    return subprocess.run(["pgrep", "-f", "[q]uarto.js preview"], capture_output=True).returncode == 0


def creado(ruta, siguiente):
    print(f"✔ Creado {ruta.relative_to(RAIZ)}")
    print(f"  Siguiente: {siguiente}")
    abrir(ruta)


