def portada(isbn, titulo, autor):
    """URL de portada de Open Library: la del ISBN si existe; si no, la de la edición que
    encuentre buscando por título y autor. None si no hay ninguna (o no hay conexión)."""
    def existe(url):
        try:
            with urllib.request.urlopen(url + "?default=false", timeout=15) as r:
                return r.status == 200
        except Exception:
            return False
    if isbn:
        url = f"https://covers.openlibrary.org/b/isbn/{isbn}-M.jpg"
        if existe(url):
            return url
    try:
        q = urllib.parse.urlencode({"title": titulo, "author": autor, "fields": "cover_i", "limit": 5})
        with urllib.request.urlopen(f"https://openlibrary.org/search.json?{q}", timeout=15) as r:
            for doc in json.load(r).get("docs", []):
                if doc.get("cover_i"):
                    return f"https://covers.openlibrary.org/b/id/{doc['cover_i']}-M.jpg"
    except Exception:
        pass
    return None


def imagemagick():
    im = next((c for c in ("magick", "convert") if shutil.which(c)), None)
    if not im:
        sys.exit("No encuentro ImageMagick (magick o convert).")
    return im


def descargar_portada(url, titulo):
    """Guarda la portada en biblioteca/datos/imgs/<título>.webp, a 240×360 (el triple de lo que se
    muestra, nítida en pantallas retina) y sin metadatos. Devuelve la ruta para libros.yml."""
    url = re.sub(r"-[SM]\.jpg$", "-L.jpg", url)      # Open Library: la grande, para reducirla con calidad
    destino = RAIZ / PORTADAS / f"{slug(titulo)}.webp"
    destino.parent.mkdir(parents=True, exist_ok=True)
    peticion = urllib.request.Request(url, headers={"User-Agent": "web-josepablo"})
    with urllib.request.urlopen(peticion, timeout=30) as r:
        imagen = r.read()
    subprocess.run([imagemagick(), "-", "-strip", "-resize", "240x360^", "-quality", "80", str(destino)],
                   input=imagen, check=True)
    return f"{PORTADA_YML}/{destino.name}"


def libro(_):
    print("Nuevo libro para la Biblioteca (Enter para dejar un campo vacío)\n")
    titulo = input("Título: ").strip()
    if not titulo:
        sys.exit("Hace falta un título.")
    autor = input("Autor/a: ").strip()
    isbn = input("ISBN (para la portada, opcional): ").replace("-", "").strip()
    estado = ""
    while estado not in ("leyendo", "leido", "pendiente"):
        estado = input("Estado [leyendo / leido / pendiente]: ").strip().lower() or "leyendo"
    rating = ""
    if estado == "leido":
        rating = input("Valoración 1-5: ").strip()
    opinion = input("Tu opinión en una línea: ").strip()

    bloque = [f"\n- title: {comillas(titulo)}", f"  autor: {comillas(autor)}"]
    print("\nBuscando la portada en Open Library…")
    url = portada(isbn, titulo, autor)
    if url:
        try:
            local = descargar_portada(url, titulo)
            bloque.append(f"  image: {local}")
            print(f"  Portada guardada en biblioteca/{local}  (ábrela para comprobar que es la edición correcta)")
        except Exception as e:
            bloque.append(f"  image: {url}")
            print(f"  No he podido descargar la portada ({e}); dejo el enlace: descárgala luego con ./web portadas")
    else:
        print("  No he encontrado portada: el libro se mostrará sin ella (puedes añadir 'image:' a mano).")
    bloque += [f"  categories: [{estado}]", f"  date: {HOY:%Y-%m-%d}"]
    if rating.isdigit():
        bloque.append(f"  rating: {max(1, min(5, int(rating)))}")
    if opinion:
        bloque.append(f"  description: {comillas(opinion)}")

    ruta = RAIZ / DATOS["libros"]
    with ruta.open("a") as f:
        f.write("\n".join(bloque) + "\n")
    print(f"\n✔ Añadido a {DATOS['libros']}")
    print("  Cuando lo termines, cambia su estado a [leido] y ponle valoración (./web editar libros)")


def portadas(_):
    """Descarga las portadas de libros.yml que aún son enlaces y pone en su lugar la ruta local.
    Sirve también para cambiar una portada: pega su URL en 'image:' y ejecuta ./web portadas."""
    ruta = RAIZ / DATOS["libros"]
    lineas = ruta.read_text().splitlines(keepends=True)
    titulo, hechas = None, 0
    for i, linea in enumerate(lineas):
        if m := re.match(r'\s*-\s*title:\s*"?(.*?)"?\s*$', linea):
            titulo = m.group(1)
        elif (m := re.match(r"(\s*image:\s*)(https?://\S+)(.*)", linea, re.S)) and titulo:
            try:
                lineas[i] = m.group(1) + descargar_portada(m.group(2), titulo) + m.group(3)
                hechas += 1
                print(f"  ✔ {titulo}")
            except Exception as e:
                print(f"  ✘ {titulo}: {e} (se queda el enlace)")
    if not hechas:
        sys.exit("No hay portadas por descargar: todas están ya en biblioteca/datos/imgs/.")
    ruta.write_text("".join(lineas))
    print(f"\n✔ {hechas} portada(s) guardada(s) en {PORTADAS}/ y {DATOS['libros']} actualizado")


